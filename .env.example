# Variáveis de Ambiente Globais para o site-cdc (Docker / Hostinger)

# Banco de Dados PostgreSQL
DB_HOST=postgres
DB_USER=cdc_user
DB_NAME=site_cdc_db
DB_PASSWORD=<SUA_SENHA_FORTE_AQUI>
PORT_DATABASE=5432

# Backend Express API
NODE_ENV=production
CORS_ORIGINS=https://super.cdc.org.br
API_INTEGRATION_KEY=<CHAVE_ALEATORIA_DE_INTEGRACAO>
EMAIL_FROM=contato@ongcdc.org.br
EMAIL_PASSWORD=<SENHA_SMTP_EMAIL>

# Painel Administrativo AdminJS
ADMIN_EMAIL=admin@ongcdc.org.br
ADMIN_PASSWORD=<SENHA_ADMIN_PAINEL>
COOKIE_SECRET=<CHAVE_ALEATORIA_COOKIE_SECRET>
GOOGLE_CLIENT_ID=<SEU_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<SEU_GOOGLE_CLIENT_SECRET>
BASE_URL=https://super.cdc.org.br

# Frontend Next.js
NEXT_PUBLIC_API_URL=https://super.cdc.org.br
NEXT_PUBLIC_STORAGE=https://super.cdc.org.br/uploads

# Enderecos publicados pelo Docker (use 127.0.0.1 quando houver proxy local)
BIND_ADDRESS=127.0.0.1
PORT_BACKEND=5001
PORT_ADMIN=3001
PORT_FRONTEND=3000
